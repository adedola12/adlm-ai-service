<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so QUIV / HERON / RateGen (.NET Framework or modern .NET) can all reference it -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdlmAi</RootNamespace>
    <AssemblyName>AdlmAi.Sdk</AssemblyName>
    <Version>0.1.0</Version>
    <Description>ADLM AI Service client SDK for ADLM .NET plugins (QUIV, HERON, RateGen).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

</Project>
