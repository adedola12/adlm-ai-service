# ── Mongo ────────────────────────────────────────────────────────────────────
# Same Atlas cluster as ADLM Cloud, but the AI service uses its OWN database.
# Never point AI_DB at adlmWeb. Local dev may use a different database name.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.lrnxr4b.mongodb.net/?appName=Cluster0
AI_DB=adlm_ai

# Read-only grounding data (RateGen library) — reads only, never writes.
GROUNDING_DB=adlmWeb
RATEGEN_MASTER_DB=ADLMRateDB
RATEGEN_MAT_COLLECTION=Materials
RATEGEN_LAB_COLLECTION=labours

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Bedrock model ids (config, never hardcoded in services)
BEDROCK_MODEL_CHEAP=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_STRONG=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Entitlement / auth ───────────────────────────────────────────────────────
# ADLM Cloud licence-token verification. HS256 shared secret (same value as
# ADLM Cloud's JWT_LICENSE_SECRET) and/or RS256 via the JWKS endpoint.
ADLM_CLOUD_URL=https://adlmweb.onrender.com
JWT_LICENSE_SECRET=
# Access-token secret (same as ADLM Cloud JWT_ACCESS_SECRET) for the web path.
JWT_ACCESS_SECRET=
# Entitlement productKey that gates AI features when AI_ACCESS_MODE=entitlement
AI_ENTITLEMENT_KEY=ai
# WHO gets AI access (business decision, hence config):
#   any-subscription — any ACTIVE ADLM entitlement grants access. Current
#     policy: AI ships to the whole subscribed base while it's being built
#     out; spend stays bounded by quotas + the credit guard, not by the gate.
#   entitlement      — only accounts holding the AI_ENTITLEMENT_KEY add-on.
#     Switch to this once AI is separately priced.
# Both modes require an ACTIVE, unexpired entitlement — a valid token alone
# is never enough.
AI_ACCESS_MODE=any-subscription

# Admin routes (server-to-server), timing-safe compared
ADMIN_API_KEY=

# ── Credit guard (config, not code) ─────────────────────────────────────────
CREDIT_TOTAL_USD=25000
CREDIT_START_DATE=2025-08-01
CREDIT_EXPIRY_DATE=2028-07-31
# Throttle non-critical features when projected burn exceeds this fraction of
# straight-line budget (1.0 = exactly on budget)
CREDIT_GUARD_THRESHOLD=1.25
# Daily spend alarm (USD)
ALARM_DAILY_SPEND_USD=50

# ── FX / quotas ──────────────────────────────────────────────────────────────
USD_NGN_RATE=1600
DEFAULT_MONTHLY_QUOTA=200

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=604800

# ── Local dev ────────────────────────────────────────────────────────────────
PORT=5100
